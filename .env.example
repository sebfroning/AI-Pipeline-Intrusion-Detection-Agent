# Copy to .env and replace all four passwords. Both Compose and Python read .env.
POSTGRES_DB=agent_memory
POSTGRES_USER=agent
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional full connection string for an external database; overrides POSTGRES_*.
# MEMORY_DATABASE_URL=postgresql://user:password@host:5432/agent_memory

# Each specialist has its own credentials, database container, and volume.
FRUIT_POSTGRES_DB=fruit_memory
FRUIT_POSTGRES_USER=fruit_agent
FRUIT_POSTGRES_PASSWORD=replace-with-a-local-password
FRUIT_POSTGRES_HOST=127.0.0.1
FRUIT_POSTGRES_PORT=5433
# FRUIT_MEMORY_DATABASE_URL=postgresql://user:password@host:5433/fruit_memory

WEATHER_POSTGRES_DB=weather_memory
WEATHER_POSTGRES_USER=weather_agent
WEATHER_POSTGRES_PASSWORD=replace-with-a-local-password
WEATHER_POSTGRES_HOST=127.0.0.1
WEATHER_POSTGRES_PORT=5434
# WEATHER_MEMORY_DATABASE_URL=postgresql://user:password@host:5434/weather_memory

MITHRIDAT_POSTGRES_DB=mithridat_memory
MITHRIDAT_POSTGRES_USER=mithridat_agent
MITHRIDAT_POSTGRES_PASSWORD=replace-with-a-local-password
MITHRIDAT_POSTGRES_HOST=127.0.0.1
MITHRIDAT_POSTGRES_PORT=5435
# MITHRIDAT_MEMORY_DATABASE_URL=postgresql://user:password@host:5435/mithridat_memory

MEMORY_PROJECT=intrusion-agent
MEMORY_EMBED_MODEL=nomic-embed-text
MEMORY_EMBED_DIMS=768
